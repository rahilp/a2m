/* a2m TUI styles. Every color is a DESIGN.md token (section 2) set by the a2m-dark / a2m-light
   themes in app.py; spacing uses the gap-0..gap-3 cell scale. */

Screen {
    background: $background;
    color: $foreground;
}

/* ---- Header: row 0, title left (bold), version right (muted) ---- */
AppHeader {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $background;
}
#hdr-title {
    width: 1fr;
    text-style: bold;
    color: $foreground;
}
#hdr-version {
    width: auto;
    text-style: bold;
    color: $foreground-muted;
}

/* ---- Footer: last row, key (bold, accent) + label (muted), 2 cells apart ---- */
Footer {
    background: $background;
    color: $foreground-muted;
    padding: 0 1;
}
Footer FooterKey {
    margin-right: 2;
    background: $background;
    color: $foreground-muted;
    & > .footer-key--key {
        padding: 0;
        background: $background;
        color: $accent;
        text-style: bold;
    }
    & > .footer-key--description {
        padding: 0 0 0 1;
        background: $background;
        color: $foreground-muted;
        text-style: none;
    }
    /* No hover band: the strip stays flush with the background, as in the prototype. */
    &:hover {
        background: $background;
        color: $foreground-muted;
    }
}

/* ---- Body: surface, 1-cell page gutter left/right, none top/bottom (DESIGN.md Layout). Every setup
   state fits 80x24; only a shorter terminal scrolls the form under the pinned Footer. ---- */
#body {
    background: $surface;
    padding: 0 1;
    height: 1fr;
}

/* ---- Spacing scale (cells) ---- */
.gap-1 {
    margin-top: 1;
}
.gap-2 {
    margin-top: 2;
}
.gap-3 {
    margin-top: 3;
}

/* ---- Text roles ---- */
/* Folder field labels are regular weight as in the prototype; section labels (AI, Command, the
   resume question) stay bold. */
.field-label {
    color: $foreground;
}
.section-label {
    text-style: bold;
    color: $foreground;
}

/* ---- Input: a round border in the border token, a heavy success/error border after a check, round accent on focus. The
   border is the .field box around a borderless one-row Input; the box and the Input share the surface
   fill, so the inside of the box is one uniform tone as in the prototype. The box stops 2 cells short
   of the right gutter. ---- */
#body .field-row {
    height: 3;
}
#body .field {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
    border: round $border;
    background: $surface;
    &.-valid {
        border: heavy $success;
    }
    &.-invalid {
        border: heavy $error;
    }
    &:focus-within {
        border: round $accent;
    }
}
#body Input {
    height: 1;
    border: none;
    background: $surface;
    color: $foreground;
    padding: 0 1;
    & > .input--placeholder {
        color: $foreground-muted;
        text-style: italic;
    }
    &:focus {
        border: none;
        background-tint: transparent;
    }
    &.-invalid, &.-invalid:focus {
        border: none;
    }
    &:disabled {
        opacity: 1;
        text-opacity: 1;
    }
}

/* ---- Browse… sits beside its field, on the field's text row, 2 cells short of the right gutter ---- */
#body .field-row > Button {
    margin: 1 2 0 0;
}

/* ---- The absolute folder a relative path names, under its field: dim, muted ---- */
.resolved {
    height: auto;
    color: $foreground-muted;
    text-style: dim;
}

/* ---- The line under a folder field: muted while checking, success or error after ---- */
.hint {
    height: auto;
    color: $foreground-muted;
    text-style: italic;
    &.-valid {
        color: $success;
        text-style: none;
    }
    &.-invalid {
        color: $error;
        text-style: none;
    }
}

/* The setup sections sit row on row (prototype renderSetup); only the Resume/Force prompt has a gap-1,
   dropped by setup.py when both folder fields show their absolute folder line, so 80x24 still fits. */

/* ---- Resume / Force choice for an earlier results folder ---- */
#resume-choice {
    height: 1;
}

/* ---- The one-line reason under a disabled Start ---- */
#start-disabled-reason {
    color: $foreground-muted;
    text-style: italic;
}

/* ---- RadioSet (AI choice): compact toggle glyphs, inner dot dimmed when off ---- */
#body RadioSet {
    background: $surface;
    &:disabled {
        opacity: 1;
        text-opacity: 1;
    }
    & > RadioButton {
        background: $surface;
        color: $foreground;
        /* background colors the outer brackets, color the inner dot (frame.bracket_glyph). */
        & > .toggle--button {
            color: $foreground-muted;
            background: $foreground-muted;
        }
        &.-on > .toggle--button {
            color: $primary;
            background: $primary;
        }
        &.-on > .toggle--label {
            text-style: bold;
        }
    }
    /* No cursor highlight unless the set has focus. */
    &:blur > RadioButton.-selected > .toggle--label {
        background: $surface;
    }
}

/* ---- Collapsible (Advanced options): header row only when closed ---- */
#body Collapsible {
    background: $surface;
    border-top: none;
    padding: 0;
    &:disabled {
        opacity: 1;
        text-opacity: 1;
    }
    CollapsibleTitle {
        padding: 0;
        color: $foreground-muted;
        text-style: none;
        &:focus {
            color: $accent;
            background: $surface;
        }
    }
}

/* ---- Advanced options body: panel, 1-cell padding left/right only (no blank rows, so the open section
   fits 80x24), short fields two to a row: label, gap-2, field; gap-3 before the row's second label ---- */
#body Collapsible {
    &:focus-within {
        background-tint: transparent;
    }
    Contents {
        padding: 0 1;
        background: $panel;
    }
}
#body .adv-row {
    height: 1;
}
.adv-label {
    width: auto;
    margin: 0 2 0 0;
    color: $foreground;
    &.adv-second {
        margin: 0 2 0 3;
    }
}
#body .adv-row Input {
    width: 13;
    padding: 0;
    background: $panel;
    /* Placeholder text is regular weight, dim and muted (DESIGN.md Typography), as in the prototype. */
    & > .input--placeholder {
        color: $foreground-muted;
        text-style: dim;
    }
    &:focus {
        background: $surface;
    }
    /* Fixed width: a long path scrolls inside the field, so the row keeps the prototype's columns. */
    &.adv-golden {
        width: 12;
    }
    &.adv-header {
        width: 14;
    }
    &.adv-attempts {
        width: 3;
    }
}
/* The line under the AI choice or in Advanced: a2m's own message, error color. */
#ai-hint, #advanced-hint {
    height: auto;
}

/* ---- Checkbox (Advanced): compact glyph, inner X dimmed when off, primary when on, accent brackets on focus ---- */
#body Checkbox {
    background: $panel;
    color: $foreground;
    /* background colors the outer brackets, color the inner X (frame.bracket_glyph). */
    & > .toggle--button {
        color: $foreground-muted;
        background: $foreground-muted;
    }
    &.-on > .toggle--button {
        color: $primary;
        background: $primary;
    }
    &:focus {
        background-tint: transparent;
        & > .toggle--button {
            background: $accent;
        }
        & > .toggle--label {
            color: $foreground;
            background: $panel;
            text-style: none;
        }
    }
    &:blur:hover > .toggle--label {
        background: $panel;
    }
}

/* ---- Command preview: one borderless line on panel ---- */
#command-preview {
    height: 1;
    width: 100%;
    background: $panel;
    color: $foreground;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---- Button: compact, one row, heavy left/right edge glyphs (setup screen and dialogs) ---- */
#body {
    scrollbar-size-vertical: 1;
}
#body Button, #picker Button, #confirm Button {
    height: 1;
    width: auto;
    min-width: 0;
    /* EdgeButton draws the label's one-cell padding itself, inside its fill (its line-pad is 0). */
    padding: 0;
    border: none;
    border-left: heavy $border;
    border-right: heavy $border;
    background: $surface;
    color: $foreground;
    text-style: none;
    & > .edge-button--fill {
        background: $surface;
        color: $foreground;
    }
    /* Filled variants fill the padded label only; the edge glyphs stay on the surface. */
    &.-primary {
        border-left: heavy $primary;
        border-right: heavy $primary;
        & > .edge-button--fill {
            background: $primary;
            color: white;
        }
    }
    &.-error {
        border-left: heavy $error;
        border-right: heavy $error;
        & > .edge-button--fill {
            background: $error;
            color: white;
        }
    }
    &:focus {
        border-left: heavy $accent;
        border-right: heavy $accent;
    }
    /* The edge glyphs stay dim border on the surface; only the padded label takes the background tint. */
    &:disabled {
        border-left: heavy $border;
        border-right: heavy $border;
        background: $surface;
        color: $foreground-muted;
        opacity: 1;
        text-opacity: 1;
        & > .edge-button--fill {
            background: $background;
            color: $foreground-muted;
        }
    }
}

/* ---- Resume and Force sit side by side, a gap-1 apart ---- */
#resume-choice Button {
    margin-right: 1;
}

/* ---- Folder browser dialog: overlay, heavy accent border; fits 80x24 above its Footer ---- */
FolderPicker {
    align: center middle;
    background: $background 60%;
}
#picker {
    width: 76;
    height: 21;
    background: $overlay;
    border: heavy $accent;
    padding: 0 1;
}
#picker-title {
    text-style: bold;
    color: $foreground;
}
/* The folder the browser is in, in full (wraps rather than cut short). */
#picker-path {
    height: auto;
    background: $panel;
    color: $foreground;
}
#picker-list {
    height: 1fr;
    background: $panel;
    border: round $border;
    &:focus {
        border: round $accent;
    }
    & > .option-list--option-highlighted {
        background: $accent;
        color: $background;
        text-style: none;
    }
    &:focus > .option-list--option-highlighted {
        background: $accent;
        color: $background;
    }
    & > .option-list--option-disabled {
        color: $foreground-muted;
        text-style: italic;
    }
}
/* What a2m makes of the highlighted folder: muted while checking, success or error after. */
#picker-preview {
    height: auto;
    max-height: 3;
    color: $foreground-muted;
    text-style: italic;
    &.-valid {
        color: $success;
        text-style: none;
    }
    &.-invalid {
        color: $error;
        text-style: none;
    }
}
#picker-buttons {
    height: 1;
    margin-top: 1;
    & > Button {
        margin-right: 1;
    }
}

/* ---- Run screen (DESIGN.md Layout, Screen anatomy Run): bar row, current step, finished list, Stop ---- */
#run-bar-row {
    height: 1;
}
#run-progress {
    width: auto;
    height: 1;
}
#run-progress Bar {
    width: 40;
    /* accent fill over a solid border-colored track (DESIGN.md Components, ProgressBar); BlockBar paints
       both as full cells, the fill from `color`, the track from `background` */
    & > .bar--bar {
        color: $accent;
        background: $border;
    }
    & > .bar--complete {
        color: $success;
        background: $border;
    }
}
#run-progress.-stopped Bar > .bar--bar {
    color: $warning;
}
/* The count and the elapsed time follow the bar with no gap, as in the prototype. */
#run-counts {
    width: auto;
    color: $foreground;
}
#run-elapsed {
    width: auto;
    color: $foreground-muted;
}
#run-current {
    height: auto;
    color: $foreground;
}
/* The outcome line: a2m's own message for a run that could not start, or how the run ended. */
#run-message {
    height: auto;
    color: $foreground;
    &.-warning {
        color: $warning;
        text-style: bold;
    }
    &.-error {
        color: $error;
        text-style: bold;
    }
    &.-success {
        color: $success;
        text-style: bold;
    }
}
#run-finished-empty {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground-muted;
    text-style: italic;
}
/* Finished proxies, newest first: dense panel rows (bucket symbol + name), scrolling inside a pane of at
   most 12 rows so the screen itself never scrolls at 80x24. */
#run-finished {
    height: auto;
    max-height: 12;
    background: $surface;
    scrollbar-size-vertical: 1;
    & > ListItem {
        padding: 0 1;
        background: $panel;
        &.-highlight {
            background: $panel;
            color: $foreground;
            text-style: none;
        }
    }
    &:focus {
        background-tint: transparent;
        & > ListItem.-highlight {
            background: $accent;
            color: $background;
            & > Static {
                color: $background;
            }
        }
    }
}
.bucket-verified {
    color: $success;
}
.bucket-needs-review {
    color: $warning;
}
.bucket-unsupported, .bucket-failed {
    color: $error;
}
#run-buttons {
    height: 1;
    & > Button {
        margin-right: 1;
    }
}

/* ---- Modal confirm (Stop, quit while a run is going): overlay, heavy warning or error border, Cancel
   focused (DESIGN.md Components, Modal confirm) ---- */
ConfirmScreen {
    align: center middle;
    background: $background 60%;
}
/* Centered with a one-row margin above, so an odd leftover row goes above the dialog, as in the
   prototype. Title, lines and buttons start in the first cell inside the heavy border. */
#confirm {
    width: 50;
    height: auto;
    margin-top: 1;
    background: $overlay;
    border: heavy $warning;
    padding: 0;
    &.-error {
        border: heavy $error;
    }
}
#confirm-title {
    text-style: bold;
    color: $foreground;
}
.confirm-line {
    color: $foreground;
}
#confirm-buttons {
    height: 1;
    margin-top: 1;
    & > Button {
        margin-right: 1;
    }
    /* The buttons sit on the dialog's overlay: Cancel's label too (the filled Stop keeps its fill), and
       focus shows only in the edge glyphs. */
    & > Button {
        background: $overlay;
        & > .edge-button--fill {
            background: $overlay;
        }
        &:focus {
            background-tint: transparent;
        }
    }
}
/* The warning shown with Force stop once a stop has outlasted a2m's clean-up budget. */
#run-force-note {
    height: auto;
    color: $warning;
}
