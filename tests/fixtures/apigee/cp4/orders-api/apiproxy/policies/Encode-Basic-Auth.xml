<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<BasicAuthentication async="false" continueOnError="false" enabled="true" name="Encode-Basic-Auth">
    <DisplayName>Encode Basic Auth</DisplayName>
    <Operation>Encode</Operation>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <User ref="creds.user"/>
    <Password ref="creds.pass"/>
    <AssignTo createNew="false">request.header.Authorization</AssignTo>
</BasicAuthentication>
