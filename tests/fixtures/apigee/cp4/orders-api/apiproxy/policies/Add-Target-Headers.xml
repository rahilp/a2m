<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="Add-Target-Headers">
    <DisplayName>Add Target Headers</DisplayName>
    <Set>
        <Headers>
            <Header name="X-Env">prod</Header>
        </Headers>
    </Set>
    <Add>
        <QueryParams>
            <QueryParam name="version">2</QueryParam>
        </QueryParams>
    </Add>
    <Remove>
        <Headers>
            <Header name="X-Internal"/>
        </Headers>
    </Remove>
    <AssignVariable>
        <Name>target.env</Name>
        <Value>prod</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
