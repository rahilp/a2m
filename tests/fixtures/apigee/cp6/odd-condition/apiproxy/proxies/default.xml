<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="curl-clients">
            <Request>
                <Step>
                    <Name>AM-Curl</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>request.header.User-Agent =| &quot;curl&quot;</Condition>
        </Flow>
        <Flow name="get-orders">
            <Request>
                <Step>
                    <Name>AM-Orders</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>request.verb = &quot;GET&quot; AND proxy.pathsuffix MatchesPath &quot;/orders&quot;</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/odd-condition</BasePath>
        <VirtualHost>default</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
