<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>SA-10ps</Name>
            </Step>
        </Request>
        <Response>
            <Step>
                <Name>JS-One</Name>
            </Step>
            <Step>
                <Name>JS-Two</Name>
            </Step>
        </Response>
    </PreFlow>
    <Flows>
        <Flow name="curl-clients">
            <Request>
                <Step>
                    <Name>AM-SetHeader</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>request.header.User-Agent =| &quot;curl&quot;</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>PY-One</Name>
            </Step>
        </Response>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/mixed</BasePath>
        <VirtualHost>default</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
