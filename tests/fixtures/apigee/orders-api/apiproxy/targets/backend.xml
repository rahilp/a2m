<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="backend">
    <Description>Orders backend</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>FC-Audit</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>OA-Token</Name>
            </Step>
            <Step>
                <Name>JC-Sign</Name>
            </Step>
        </Response>
    </PostFlow>
    <HTTPTargetConnection>
        <Properties/>
        <URL>https://orders.example.com/api</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
