<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>VK-ClientKey</Name>
            </Step>
            <Step>
                <Name>AM-Channel</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="GetProfile">
            <Request>
            <Step>
                <Name>AM-ProfileView</Name>
            </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/profile") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="GetPreferences">
            <Request>
            <Step>
                <Name>AM-PrefsView</Name>
            </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/preferences") and (request.verb = "GET")</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/customers/v1</BasePath>
        <VirtualHost>default</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
